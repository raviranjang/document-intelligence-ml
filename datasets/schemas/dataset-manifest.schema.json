{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Intelligence Dataset Manifest",
  "description": "Versioned lineage and immutable artifact references for an ML dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "created_at",
    "tasks",
    "sources",
    "split_strategy",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Version of this manifest contract, independent of the dataset version."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "Immutable semantic version of the dataset contents."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ocr_detection",
          "ocr_recognition",
          "document_classification",
          "semantic_extraction"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "split_strategy": {
      "$ref": "#/$defs/split_strategy"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1,
          "description": "Relative or remote URI; large artifacts must live outside Git."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "uri": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "split_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["source_provided", "grouped", "manual"]
        },
        "grouping_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "grouped"
              }
            },
            "required": ["method"]
          },
          "then": {
            "required": ["grouping_keys"],
            "properties": {
              "grouping_keys": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "document"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$",
          "maxLength": 256
        },
        "split": {
          "enum": ["training", "validation", "test"]
        },
        "cohorts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "groups": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "Pseudonymized grouping values used to prevent split leakage."
        },
        "document": {
          "$ref": "#/$defs/artifact"
        },
        "annotation": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  }
}
