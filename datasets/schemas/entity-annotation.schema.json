{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raviranjang/document-intelligence-ml/datasets/schemas/entity-annotation.schema.json",
  "title": "Semantic entity annotation",
  "description": "Token-level BIO annotations aligned to canonical OCR output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label_schema_version",
    "source_ocr_schema_version",
    "document_id",
    "pages"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "label_schema_version": {"const": "1.0.0"},
    "source_ocr_schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_index", "image_width", "image_height", "tokens"],
      "properties": {
        "page_index": {"type": "integer", "minimum": 0},
        "image_width": {"type": "integer", "minimum": 1},
        "image_height": {"type": "integer", "minimum": 1},
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_index", "text", "bounding_box", "label"],
      "properties": {
        "token_index": {"type": "integer", "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "bounding_box": {"$ref": "#/$defs/bounding_box"},
        "label": {
          "enum": [
            "O",
            "B-ORDER_REFERENCE",
            "I-ORDER_REFERENCE",
            "B-INVOICE_NUMBER",
            "I-INVOICE_NUMBER",
            "B-SELLER_NAME",
            "I-SELLER_NAME",
            "B-TOTAL_AMOUNT",
            "I-TOTAL_AMOUNT",
            "B-INVOICE_DATE",
            "I-INVOICE_DATE"
          ]
        }
      }
    },
    "bounding_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "x_min": {"type": "number", "minimum": 0},
        "y_min": {"type": "number", "minimum": 0},
        "x_max": {"type": "number", "exclusiveMinimum": 0},
        "y_max": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
